---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
    {
        number: "01",
        date: "Marzo 2026 — Agosto 2026",
        title: "Soporte Técnico & Desarrollo de Sistemas",
        company: "Cámara de Comercio Shangai China, Ecuador",
        description:
            "Brindé soporte técnico institucional y desarrollé sistemas internos para automatizar procesos de distintas áreas. Implementé flujos en Salesforce y optimicé Kommo CRM para centralizar el seguimiento de clientes y mejorar la trazabilidad comercial.",
    },
    {
        number: "02",
        date: "Julio 2025 — Actualidad",
        title: "Freelancer",
        company: "Desarrollo Web · UI/UX · Consultoría Técnica",
        description:
            "Desarrollo soluciones digitales a medida para emprendedores, pequeñas empresas y organizaciones. Combino desarrollo web, diseño de interfaces y consultoría técnica para convertir necesidades reales en soluciones funcionales y modernas.",
        link: "mailto:carlosdanielsm.dev@gmail.com",
    },
    {
        number: "03",
        date: "Julio 2024",
        title: "Desarrollador Web & Sistemas",
        company: "Coordinación Zonal 9 de Salud",
        description:
            "Lideré la reingeniería y optimización del sistema de inventario tecnológico institucional. Identifiqué problemas en la arquitectura anterior y desarrollé una solución que eliminó errores de registro, mejoró la integridad de los datos y optimizó la gestión de recursos.",
        link: "https://github.com/carlodaniel-dev/It-inventorySystem",
    },
    {
        number: "04",
        date: "Febrero 2024",
        title: "Desarrollador Web",
        company: "Centro La Perfecta Alegría",
        description:
            "Diseñé y desarrollé interfaces web responsive y accesibles, mejorando la presencia digital de la organización mediante soluciones orientadas a la experiencia de usuario y al posicionamiento digital.",
    },
];
---

<section class="w-full scroll-mt-28">
    <div class="mx-auto max-w-6xl">
        <!-- Encabezado -->
        <div
            class="grid gap-6 border-b border-white/10 pb-10 md:grid-cols-[1fr_2fr] md:items-end"
        >
            <div>
                <span
                    class="font-mono text-xs uppercase tracking-[0.2em] text-[#FFD166]"
                >
                    01 — Experiencia
                </span>

                <h2
                    class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-5xl"
                >
                    Donde he aportado
                </h2>
            </div>

            <p
                class="max-w-xl text-sm leading-relaxed text-[#C9C3D8] sm:text-base md:justify-self-end"
            >
                Experiencia desarrollando sistemas, automatizando procesos y
                creando soluciones digitales para organizaciones y proyectos
                independientes.
            </p>
        </div>

        <!-- Experiencias -->
        <ol>
            {EXPERIENCE.map((experience) => <ExperienceItem {...experience} />)}
        </ol>
    </div>
</section>
