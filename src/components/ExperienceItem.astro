---
interface Props {
    number: string;
    title: string;
    company: string;
    date: string;
    description: string;
    link?: string;
}

const { number, title, company, date, description, link } = Astro.props;

const isEmail = link?.startsWith("mailto:");
---

<li class="group border-b border-white/10 py-7 sm:py-8">
    <div class="grid gap-5 md:grid-cols-[3rem_1fr_auto] md:gap-6">
        <!-- Número -->
        <span
            class="font-mono text-xs tracking-wider text-[#FFD166]"
            aria-hidden="true"
        >
            {number}
        </span>

        <!-- Información -->
        <div>
            <div
                class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-3"
            >
                <h3
                    class="text-lg font-semibold tracking-tight text-white transition-colors group-hover:text-[#FFD166] sm:text-xl"
                >
                    {title}
                </h3>

                <span class="text-sm text-[#C9C3D8]">
                    {company}
                </span>
            </div>

            <p
                class="mt-3 max-w-2xl text-sm leading-relaxed text-[#C9C3D8] sm:text-base"
            >
                {description}
            </p>

            {
                link && (
                    <a
                        href={link}
                        target={isEmail ? undefined : "_blank"}
                        rel={isEmail ? undefined : "noopener noreferrer"}
                        class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-wider text-white transition-colors hover:text-[#FFD166]"
                    >
                        {isEmail ? "Contáctame" : "Ver proyecto"}
                        <span
                            class="transition-transform duration-200 group-hover:translate-x-0.5"
                            aria-hidden="true"
                        >
                            →
                        </span>
                    </a>
                )
            }
        </div>

        <!-- Fecha -->
        <time class="font-mono text-xs text-[#C9C3D8] md:pt-1 md:text-right">
            {date}
        </time>
    </div>
</li>
