---
import { Image } from "astro:assets";
import miFoto from "../assets/img/cdPerfil.webp";
---

<header class="fixed inset-x-0 top-0 z-50 flex justify-center px-4 py-4">
    <div
        class="flex w-full max-w-4xl items-center justify-between rounded-full border border-white/10 bg-[#160D2B]/70 px-5 py-3 backdrop-blur-xl"
    >
        <!-- Logo / identidad -->
        <a
            href="#top"
            class="group flex items-center gap-2.5"
            aria-label="Inicio"
        >
            <span
                id="nav-avatar"
                class="size-7 overflow-hidden rounded-full opacity-0 scale-75 -translate-x-2 transition-all duration-500"
            >
                <Image
                    src={miFoto}
                    alt=""
                    width={56}
                    height={56}
                    class="size-full object-cover"
                />
            </span>

            <span
                class="shrink-0 text-sm font-semibold tracking-tight text-white transition-colors group-hover:text-[#FFD166]"
            >
                CD / DEV
            </span>
        </a>

        <!-- Navegación -->
        <nav
            class="hidden items-center gap-7 text-sm font-medium text-[#C9C3D8] md:flex"
            aria-label="Navegación principal"
        >
            <a href="#experience" class="transition-colors hover:text-white">
                Experiencia
            </a>

            <a href="#projects" class="transition-colors hover:text-white">
                Proyectos
            </a>

            <a href="#about" class="transition-colors hover:text-white">
                Sobre mí
            </a>
        </nav>

        <!-- CTA -->
        <a
            href="mailto:carlosdanielsm.dev@gmail.com"
            class="group inline-flex items-center gap-1.5 rounded-full bg-[#FFD166] px-4 py-2 text-sm font-semibold text-[#160D2B] transition-transform hover:scale-105"
        >
            Hablemos
            <span
                class="transition-transform duration-200 group-hover:translate-x-0.5"
            >
                →
            </span>
        </a>
    </div>
</header>

<script>
    const navAvatar = document.querySelector("#nav-avatar");

    const handleScroll = () => {
        if (!navAvatar) return;

        if (window.scrollY > 80) {
            navAvatar.classList.remove(
                "opacity-0",
                "scale-75",
                "-translate-x-2",
            );

            navAvatar.classList.add(
                "opacity-100",
                "scale-100",
                "translate-x-0",
            );
        } else {
            navAvatar.classList.remove(
                "opacity-100",
                "scale-100",
                "translate-x-0",
            );

            navAvatar.classList.add("opacity-0", "scale-75", "-translate-x-2");
        }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });

    handleScroll();
</script>
