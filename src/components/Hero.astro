---
import { Image } from "astro:assets";
import miFoto from "../assets/img/cdPerfil.webp";

import GithubIcon from "../components/icons/GitHub.astro";
import LinkedInIcon from "../components/icons/LinkedIn.astro";
---

<section class="flex min-h-[calc(100vh-5rem)] w-full items-center md:pt-28">
    <div
        class="grid w-full max-w-6xl items-center gap-12 md:grid-cols-[1fr_auto] md:gap-16"
    >
        <!-- Contenido principal -->
        <div class="max-w-3xl">
            <!-- Estado / ubicación -->
            <div
                class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs uppercase tracking-widest text-[#C9C3D8]"
            >
                <span class="flex items-center gap-2">
                    <span
                        class="size-2 rounded-full bg-[#FFD166]"
                        aria-hidden="true"></span>
                    Disponible para trabajar
                </span>

                <span class="text-white/20">/</span>

                <span>Quito, Ecuador</span>
            </div>

            <!-- Título -->
            <h1
                class="max-w-3xl text-4xl font-semibold leading-[1.05] tracking-tight text-white sm:text-5xl md:text-6xl lg:text-7xl"
            >
                Desarrollo soluciones digitales para
                <span class="text-[#FFD166]">problemas reales.</span>
            </h1>

            <!-- Descripción -->
            <p
                class="mt-7 max-w-2xl text-base leading-relaxed text-[#C9C3D8] sm:text-lg md:text-xl"
            >
                Soy <strong class="font-medium text-white">Carlos Daniel</strong
                >, Ingeniero en Ciencias de la Computación y desarrollador de
                software. Diseño y construyo sistemas que automatizan procesos,
                optimizan operaciones y convierten necesidades reales en
                soluciones funcionales.
            </p>

            <a
                href=""
                class="group mt-8 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-white transition-colors hover:text-[#FFD166]"
            >
                Conoce más en mi blog (Proximamente)
                <span
                    class="transition-transform duration-200 group-hover:translate-x-1"
                    aria-hidden="true"
                >
                    →
                </span>
            </a>

            <!-- Acciones -->
            <div class="mt-9 flex flex-wrap items-center gap-3">
                <a
                    href="mailto:carlosdanielsm.dev@gmail.com"
                    class="group inline-flex items-center gap-2 rounded-full bg-[#FFD166] px-5 py-3 text-sm font-semibold text-[#160D2B] transition-transform hover:scale-105"
                >
                    Hablemos
                    <span
                        class="transition-transform duration-200 group-hover:translate-x-1"
                        aria-hidden="true">→</span
                    >
                </a>

                <a
                    href="https://github.com/carlodaniel-dev"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-medium text-[#C9C3D8] backdrop-blur-sm transition-colors hover:border-white/20 hover:text-white"
                >
                    <GithubIcon class="size-4" />
                    GitHub
                </a>

                <a
                    href="https://www.linkedin.com/in/carlos-salcan/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-medium text-[#C9C3D8] backdrop-blur-sm transition-colors hover:border-white/20 hover:text-white"
                >
                    <LinkedInIcon class="size-4" />
                    LinkedIn
                </a>
            </div>
        </div>

        <!-- Fotografía -->
        <div class="flex justify-start md:justify-end">
            <div class="relative">
                <div
                    class="absolute -inset-3 rounded-full border border-white/5"
                    aria-hidden="true"
                >
                </div>

                <Image
                    id="hero-avatar"
                    class="relative size-32 rounded-full object-cover ring-1 ring-white/10 transition-all duration-500 sm:size-40 md:size-52"
                    src={miFoto}
                    alt="Foto de Carlos Daniel"
                    width={416}
                    height={416}
                    densities={[1, 1.5, 2]}
                />
            </div>
        </div>
    </div>
</section>

<script>
    const heroAvatar = document.querySelector("#hero-avatar");

    const handleScroll = () => {
        if (!heroAvatar) return;

        if (window.scrollY > 80) {
            heroAvatar.classList.add("opacity-0", "scale-90", "-translate-y-3");
        } else {
            heroAvatar.classList.remove(
                "opacity-0",
                "scale-90",
                "-translate-y-3",
            );
        }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });

    handleScroll();
</script>
