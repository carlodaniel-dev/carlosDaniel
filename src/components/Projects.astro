---
import ButtonUi from "./ui/Button.astro";
import LinkIcon from "./icons/Link.astro";
import GitHubIcon from "./icons/GitHub.astro";

import { Image } from "astro:assets";

import imgProyect from "../assets/img/projects/perfectAlegria.webp";
import imgOdonto from "../assets/img/projects/odontologia.webp";
import imgProductMatch from "../assets/img/projects/product.webp";
import imgEnfermeria from "../assets/img/projects/enfermeria.webp";

const PROJECTS = [
    {
        title: "Sistema de Enfermería Escolar — AMMI",
        description:
            "Sistema de gestión de enfermería escolar desarrollado en Python para digitalizar y optimizar el registro de atenciones. Incorpora alertas automáticas, reportes estadísticos y sincronización entre equipos, mejorando la trazabilidad y reduciendo la dependencia de procesos manuales.",
        github: "https://github.com/carlodaniel-dev/office-nurse",
        image: imgEnfermeria,
        technologies: ["Python", "SQLite"],
    },
    {
        title: "Automatización de Sourcing con LLMs",
        description:
            "Automatización de sourcing con IA: de un Excel de productos a una lista rankeada de proveedores equivalentes en minutos, no horas. Construido con control de costos y manejo seguro de credenciales en mente.",
        github: "https://github.com/carlodaniel-dev/products-match",
        image: imgProductMatch,
        technologies: ["Next.js", "OpenAI"],
    },
    {
        title: "Dental Education Site",
        description:
        "Landing page diseñada para optimizar la presencia digital del sector odontológico. Enfocada en la experiencia de usuario, con una arquitectura de información clara para facilitar el acceso a recursos educativos y el contacto de los pacientes.",
        link: "https://carlodaniel-dev.github.io/dental-education-site/recursos/",
        github: "https://github.com/carlodaniel-dev/dental-education-site",
        image: imgOdonto,
        technologies: ["Astro"],
    },
    {
        title: "Centro La Perfecta Alegría",
        description:
            "Landing page diseñada para optimizar la presencia digital del centro de salud mental. Enfocada en la experiencia de usuario, con una arquitectura de información clara para facilitar el contacto de los pacientes.",
        link: "https://carlodaniel-dev.github.io/centro-perfectaAlegria/",
        github: "https://github.com/carlodaniel-dev/centro-perfectaAlegria",
        image: imgProyect,
        technologies: ["HTML", "CSS", "JavaScript"],
    },
];
---

<!-- Encabezado -->
<div
    class="grid gap-6 border-b border-white/10 pb-10 md:grid-cols-[1fr_auto] md:items-end"
>
    <div>
        <span
            class="font-mono text-xs uppercase tracking-[0.2em] text-[#FFD166]"
        >
            02 — Proyectos
        </span>

        <h2
            class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-5xl"
        >
            Ideas convertidas en soluciones
        </h2>
    </div>

    <div class="flex flex-col gap-4 md:items-end">
        <p
            class="max-w-xl text-sm leading-relaxed text-[#C9C3D8] sm:text-base md:text-right"
        >
            Una selección de proyectos donde he trabajado en desarrollo web,
            automatización, IA y sistemas para resolver problemas reales.
        </p>

        <!-- Navegación -->
        <div class="hidden items-center gap-4 md:flex">
            <span
                id="projects-counter"
                class="font-mono text-xs tabular-nums text-[#C9C3D8]"
                aria-live="polite"
            >
                01 / 04
            </span>

            <div class="flex items-center gap-1">
                <button
                    id="projects-prev"
                    type="button"
                    aria-label="Proyecto anterior"
                    class="flex size-9 items-center justify-center rounded-full border border-white/10 text-[#C9C3D8] transition-all duration-200 hover:border-white/20 hover:bg-white/5 hover:text-white disabled:pointer-events-none disabled:opacity-30"
                >
                    <span aria-hidden="true">←</span>
                </button>

                <button
                    id="projects-next"
                    type="button"
                    aria-label="Siguiente proyecto"
                    class="flex size-9 items-center justify-center rounded-full border border-white/10 text-[#C9C3D8] transition-all duration-200 hover:border-[#FFD166]/40 hover:bg-[#FFD166]/10 hover:text-[#FFD166] disabled:pointer-events-none disabled:opacity-30"
                >
                    <span aria-hidden="true">→</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Galería -->
<div class="mt-10 w-full">
    <div
        id="projects-gallery"
        class="flex gap-5 overflow-x-auto snap-x snap-mandatory pb-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
        {
            PROJECTS.map(
                (
                    {
                        image,
                        title,
                        description,
                        link,
                        github,
                        technologies,
                    },
                    index,
                ) => (
                    <article
                        class="project-slide group w-full shrink-0 md:w-[44vw] md:max-w-560px md:snap-start"
                    >
                        <!-- Imagen -->
                        <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/0.03">
                            <div class="aspect-video max-h-300px overflow-hidden">
                                <Image
                                    src={image}
                                    alt={`Captura de pantalla del proyecto ${title}`}
                                    class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
                                    loading={index === 0 ? "eager" : "lazy"}
                                />
                            </div>
                        </div>

                        <!-- Información -->
                        <div class="mt-6">
                            <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
                                <span
                                    class="font-mono text-xs tracking-wider text-[#FFD166]"
                                >
                                    {String(index + 1).padStart(2, "0")}
                                </span>

                                <span
                                    class="h-px w-6 bg-white/10"
                                    aria-hidden="true"
                                ></span>

                                <div class="flex flex-wrap gap-x-3 gap-y-1">
                                    {
                                        technologies.map((technology) => (
                                            <span class="font-mono text-[11px] uppercase tracking-wider text-[#C9C3D8]">
                                                {technology}
                                            </span>
                                        ))
                                    }
                                </div>
                            </div>

                            <h3
                                class="text-2xl font-semibold tracking-tight text-white sm:text-3xl"
                            >
                                {title}
                            </h3>

                            <p
                                class="mt-3 max-w-2xl text-sm leading-relaxed text-[#C9C3D8] sm:text-base"
                            >
                                {description}
                            </p>

                            <!-- Acciones -->
                            <footer class="mt-5 flex flex-wrap gap-3">
                                {
                                    github && (
                                        <ButtonUi href={github}>
                                            <GitHubIcon class="size-5" />
                                            Code
                                        </ButtonUi>
                                    )
                                }

                                {
                                    link && (
                                        <ButtonUi href={link}>
                                            <LinkIcon class="size-4" />
                                            Preview
                                        </ButtonUi>
                                    )
                                }
                            </footer>
                        </div>
                    </article>
                ),
            )
        }
    </div>
</div>

<script>
    const gallery = document.querySelector("#projects-gallery");
    const slides = document.querySelectorAll(".project-slide");
    const prevButton = document.querySelector("#projects-prev");
    const nextButton = document.querySelector("#projects-next");
    const counter = document.querySelector("#projects-counter");

    if (
        gallery instanceof HTMLElement &&
        prevButton instanceof HTMLButtonElement &&
        nextButton instanceof HTMLButtonElement &&
        counter instanceof HTMLElement
    ) {
        let currentIndex = 0;

        const updateCounter = (index: number) => {
            currentIndex = Math.max(
                0,
                Math.min(index, slides.length - 1),
            );

            counter.textContent = `${String(currentIndex + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;

            prevButton.disabled = currentIndex === 0;
            nextButton.disabled =
                currentIndex === slides.length - 1;
        };

        const updateGallery = (index: number) => {
            updateCounter(index);

            const slide = slides[currentIndex];

            if (slide instanceof HTMLElement) {
                gallery.scrollTo({
                    left: slide.offsetLeft - gallery.offsetLeft,
                    behavior: "smooth",
                });
            }
        };

        prevButton.addEventListener("click", () => {
            updateGallery(currentIndex - 1);
        });

        nextButton.addEventListener("click", () => {
            updateGallery(currentIndex + 1);
        });

        gallery.addEventListener("scroll", () => {
            let closestIndex = currentIndex;
            let smallestDistance = Infinity;

            slides.forEach((slide, index) => {
                if (!(slide instanceof HTMLElement)) return;

                const distance = Math.abs(
                    slide.offsetLeft -
                        gallery.offsetLeft -
                        gallery.scrollLeft,
                );

                if (distance < smallestDistance) {
                    smallestDistance = distance;
                    closestIndex = index;
                }
            });

            if (closestIndex !== currentIndex) {
                updateCounter(closestIndex);
            }
        });

        updateCounter(0);
    }
</script>


