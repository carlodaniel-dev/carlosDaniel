---
import AstroIcon from "./icons/AstroIcon.astro";
import Html from "./icons/Html.astro";
import Css from "./icons/Css.astro";
import Js from "./icons/Js.astro";
import Next from "./icons/Next.astro";
import OpenIA from "./icons/OpenIA.astro";
import Python from "./icons/Python.astro";
import SqLite from "./icons/SqLite.astro";

import ButtonUi from "./ui/Button.astro";
import LinkIcon from "./icons/Link.astro";
import GitHubIcon from "./icons/GitHub.astro";

import { Image } from "astro:assets";
import imgProyect from "../assets/img/projects/perfectAlegria.webp";
import imgOdonto from "../assets/img/projects/odontologia.webp";
import imgProductMatch from "../assets/img/projects/product.webp";
import imgEnfermeria from "../assets/img/projects/enfermeria.webp";

const TAGS = {
    AstroIcon: {
        name: "Astro",
        color: "bg-[#ff5f5f]/10 text-[#ff5f5f] border border-[#ff5f5f]/20",
        icon: AstroIcon,
    },
    HTML: {
        name: "HTML",
        color: "bg-[#e34f26]/10 text-[#ff6d45] border border-[#e34f26]/20",
        icon: Html,
    },
    CSS: {
        name: "CSS",
        color: "bg-[#1572b6]/10 text-[#30a9ff] border border-[#1572b6]/20",
        icon: Css,
    },
    JS: {
        name: "JavaScript",
        color: "bg-[#f7df1e]/10 text-[#f7df1e] border border-[#f7df1e]/20",
        icon: Js,
    },
    Next: {
        name: "Next.js",
        color: "bg-white/10 text-gray border border-gray/20",
        icon: Next,
    },
    OpenAI: {
        name: "OpenAI",
        color: "bg-[#10a37f]/10 text-[#0d8f70] border border-[#10a37f]/20",
        icon: OpenIA,
    },
    Python: {
        name: "Python",
        color: "bg-[#3776ab]/10 text-[#4daeff] border border-[#3776ab]/20",
        icon: Python,
    },
    SqLite: {
        name: "SQLite",
        color: "bg-red/10 text-[#40A8E0] border border-[#0F80CC]/20",
        icon: SqLite,
    },
};

const PROJECTS = [
    {
        title: "Centro La Perfecta Alegría",
        description:
            "Landing page diseñada para optimizar la presencia digital del centro de salud mental. Enfocada en la experiencia de usuario, con una arquitectura de información clara para facilitar el contacto de los pacientes.",
        link: "https://carlodaniel-dev.github.io/centro-perfectaAlegria/",
        github: "https://github.com/carlodaniel-dev/centro-perfectaAlegria",
        image: imgProyect,
        tags: [TAGS.HTML, TAGS.CSS, TAGS.JS],
    },
    {
        title: "Dental Education Site",
        description:
            "Landing page diseñada para optimizar la presencia digital del sector odontológico. Enfocada en la experiencia de usuario, con una arquitectura de información clara para facilitar el acceso a recursos educativos y el contacto de los pacientes.",
        link: "https://carlodaniel-dev.github.io/dental-education-site/recursos/",
        github: "https://github.com/carlodaniel-dev/dental-education-site",
        image: imgOdonto,
        tags: [TAGS.AstroIcon],
    },
    {
        title: "Automatización de Sourcing con LLMs",
        description:
            "Automatización de sourcing con IA: de un Excel de productos a una lista rankeada de proveedores equivalentes en minutos, no horas. Construido con control de costos y manejo seguro de credenciales en mente.",
        github: "https://github.com/carlodaniel-dev/products-match",
        image: imgProductMatch,
        tags: [TAGS.Next, TAGS.OpenAI],
    },
    {
        title: "Sistema de Enfermería Escolar — AMMI",
        description:
            "Sistema de gestión de enfermería escolar desarrollado en Python para digitalizar y optimizar el registro de atenciones. Incorpora alertas automáticas, reportes estadísticos y sincronización entre equipos, mejorando la trazabilidad y reduciendo la dependencia de procesos manuales.",
        github: "https://github.com/carlodaniel-dev/office-nurse",
        image: imgEnfermeria,
        tags: [TAGS.Python, TAGS.SqLite],
    },
];
---

<div class="w-full flex flex-col gap-y-16">
    {
        PROJECTS.map(({ image, title, description, tags, link, github }) => (
            <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
                <div class="w-full md:w-1/2">
                    <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
                        <Image
                            src={image}
                            alt={`Captura de pantalla del proyecto ${title}`}
                            class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                            loading="lazy"
                        />
                    </div>
                </div>

                <div class="w-full md:w-1/2 md:max-w-lg">
                    <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
                        {title}
                    </h3>
                    <div class="flex flex-wrap mt-2">
                        <ul class="flex flex-row mb-2 gap-x-2">
                            {tags.map((tag) => (
                                <li>
                                    <span
                                        class={`flex gap-x-2 rounded-full text-xs ${tag.color} py-1 px-2 `}
                                    >
                                        <tag.icon class="size-4" />
                                        {tag.name}
                                    </span>
                                </li>
                            ))}
                        </ul>

                        <div class="w-full mt-2 text-gray-700 dark:text-gray-400">
                            {description}
                        </div>

                        <footer class="flex items-end justify-start mt-4 gap-x-4">
                            {github && (
                                <ButtonUi href={github}>
                                    <GitHubIcon class="size-6" />
                                    Code
                                </ButtonUi>
                            )}
                            {link && (
                                <ButtonUi href={link}>
                                    <LinkIcon class="size-4" />
                                    Preview
                                </ButtonUi>
                            )}
                        </footer>
                    </div>
                </div>
            </article>
        ))
    }
</div>
