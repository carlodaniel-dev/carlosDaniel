---
import "../styles/global.css";

import Layout from "../layouts/Layout.astro";

import SectionContainer from "../components/SectionContainer.astro";

import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import AboutMe from "../components/AboutMe.astro";
import CTA from "../components/CTA.astro";
---

<Layout
    title="Portfolio | Carlos Salcán - Desarrollador y Programador Web"
    description="Contrata a Carlos Daniel para crear tus aplicaciones web y resolver tus problemas con soluciones digitales únicas, modernas y eficientes ✨🚀."
>
    <div class="flex flex-col gap-y-16 md:gap-y-24">
        <SectionContainer>
            <Hero />
        </SectionContainer>

        <SectionContainer id="experience">
            <Experience />
        </SectionContainer>

        <SectionContainer id="projects">
            <Projects />
        </SectionContainer>

        <SectionContainer id="about">
            <AboutMe />
        </SectionContainer>

        <CTA />
    </div>
</Layout>
